@baseUrl = {{$dotenv API_BASE_URL}}
@adminEmail = {{$dotenv TEST_ADMIN_EMAIL}}
@adminPassword = {{$dotenv TEST_ADMIN_PASSWORD}}
@adminAuthToken = {{loginAdmin.response.body.$.token}}
@userAuthToken = {{loginUser.response.body.$.token}}
@userEmail = {{$dotenv TEST_USER_EMAIL}}
@userPassword = {{$dotenv TEST_USER_PASSWORD}}

// Auth

# @name loginAdmin
POST {{baseUrl}}/api/admins/auth-with-password
Content-Type: application/json

{
    "identity": "{{adminEmail}}",
    "password": "{{adminPassword}}"
}

### Login as User

# @name loginUser
POST {{baseUrl}}/api/collections/users/auth-with-password
Content-Type: application/json

{
    "identity": "{{userEmail}}",
    "password": "{{userPassword}}"
}

### Get User
@userId = 59ctbvks6ldwpc0
GET {{baseUrl}}/api/collections/users/records/{{userId}}

// Posts

### Get all posts
GET {{baseUrl}}/api/collections/posts/records

### Get a post by id
@postId = rzd828p1mtz2zvf
GET {{baseUrl}}/api/collections/posts/records/{{postId}}

### Create post
POST {{baseUrl}}/api/collections/posts/records
Content-Type: application/json
Authorization: {{adminAuthToken}}

{
    "profile_id": "p9z41nh6www67rz",
    "title": "test",
    "summary": "null",
    "tags": "null",
    "thumbnail_id": "null",
    "source_url": "test.com"
}

### Update post
@productId = bv5m19uhqqftqb5
PUT {{baseUrl}}/api/collections/posts/records/{{productId}}
Content-Type: application/json
Authorization: {{adminAuthToken}}

{
    "profile_id": "bv5m19uhqqftqb5",
    "title": "test",
    "summary": "test",
    "tags": "JSON",
    "thumbnail_id": "RELATION_RECORD_ID",
    "source_url": "test"
}


### Reactions
GET {{baseUrl}}/api/collections/reactions/records


  ///           ///
 /// Bookmarks ///
///           ///

### List
GET {{baseUrl}}/api/collections/bookmarks/records

### Create
POST {{baseUrl}}/api/collections/bookmarks/records
Content-Type: application/json
Authorization: {{userAuthToken}}

{
    "user_id": "p9z41nh6www67rz",
    "post_id": "0dlcr7lre4kv29p"
}
